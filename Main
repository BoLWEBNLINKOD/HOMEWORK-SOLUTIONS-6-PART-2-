public class Main {
    public static void main(String[] args) {
        Light livingRoomLight = new Light();
        Thermostat thermostat = new Thermostat();

        Command lightOn = new TurnOnLightCommand(livingRoomLight);
        Command setTemp22 = new SetThermostatCommand(thermostat, 22);
        Command goodnightMacro = new MacroCommand(new Command[] {
            new TurnOnLightCommand(livingRoomLight),
            new SetThermostatCommand(thermostat, 18)
        });

        SmartHomeRemoteControl remote = new SmartHomeRemoteControl();

        remote.assign("A", lightOn);
        remote.assign("B", setTemp22);
        remote.assign("GOODNIGHT", goodnightMacro);

        remote.pressButton("A");
        remote.pressButton("B");
        remote.undoButton();

        remote.pressButton("GOODNIGHT");
        remote.undoButton();  
    }
}
